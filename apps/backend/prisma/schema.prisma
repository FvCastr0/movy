generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SDR
  CLOSER
  GESTOR
}

enum LeadOriginType {
  INBOUND
  OUTBOUND
}

enum LeadStage {
  NOVO
  PRE_QUALIFICADO
  DESQUALIFICADO
  CONTATO_INICIADO
  REUNIAO_AGENDADA
  NO_SHOW
  PROPOSTA_ENVIADA
  FECHADO
  GANHO
  PERDIDO
}

enum LeadPriority {
  ALTA
  EM_DESENVOLVIMENTO
  BAIXA_PRONTIDAO
  INCOMPLETA
}

enum MeetingCondition {
  ATENDIDAS
  RESOLVER_CRITERIOS_MINIMOS
  CONCLUIR_NOTAS
}

enum ForwardingAction {
  AGENDAR_CLOSER
  COMBINAR_RETORNO
  REVISAR_NOTAS
  PREENCHER_FICHA
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         UserRole       @default(SDR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        Lead[]         @relation("SdrLeads")
  closerLeads  Lead[]         @relation("CloserLeads")
  followUps    LeadFollowUp[]
  clients      Client[]       @relation("AccountManagerClients")
  stageHistories LeadStageHistory[]

  @@map("users")
}

model Lead {
  id                  String              @id @default(uuid())
  nome                String
  whatsapp            String
  deliveryNome        String
  segmento            String
  cidade              String
  stage               LeadStage           @default(NOVO)
  origem              String              @default("LANDING_PAGE")
  origemTipo          LeadOriginType      @default(INBOUND)
  
  // Dados de Negociação / CRM Comercial
  dealValue           Float?
  meetingDate         DateTime?
  lostReason          String?
  
  // Status de notificação no grupo WhatsApp via Evolution API
  notificationStatus  NotificationStatus  @default(PENDING)
  notificationError   String?

  // Dados de Contexto SDR / Negócio
  instagramCardapio   String?
  faturamentoMensal   Float?
  pedidosMensais      Int?
  ticketMedio         Float?
  midiaAtualMensal    Float?
  canalEntrada        String?             @default("Landing Page")
  decisoresCargos     String?
  prazoDesejadoInicio String?
  problemaPrincipal   String?
  metaCliente         String?
  historicoAgencias   String?
  recursosDeclarados  String?

  sdrResponsibleId    String?
  sdrResponsible      User?               @relation("SdrLeads", fields: [sdrResponsibleId], references: [id], onDelete: SetNull)

  closerResponsibleId String?
  closerResponsible   User?               @relation("CloserLeads", fields: [closerResponsibleId], references: [id], onDelete: SetNull)

  qualification       LeadQualification?
  followUps           LeadFollowUp[]
  stageHistories      LeadStageHistory[]
  client              Client?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("leads")
}

model LeadQualification {
  id                          String           @id @default(uuid())
  leadId                      String           @unique
  lead                        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // 6 Critérios Oficiais (0 a 3, null = pendente)
  scorePerfil                 Int?
  justificativaPerfil         String?

  scoreCapacidadeOperacional  Int?
  justificativaOperacional    String?

  scoreNecessidadeObjetivo    Int?
  justificativaNecessidade    String?

  scoreCapacidadeInvestir     Int?
  justificativaInvestir       String?

  scoreAcessoDecisor          Int?
  justificativaDecisor        String?

  scoreMomentoContratacao     Int?
  justificativaMomento        String?

  // Resultados Computados
  totalScore                  Int?
  priority                    LeadPriority     @default(INCOMPLETA)
  meetingCondition            MeetingCondition @default(CONCLUIR_NOTAS)
  forwardingAction            ForwardingAction @default(PREENCHER_FICHA)

  // Próximos passos e pendências
  pendenciasCloser            String?
  proximaAcao                 String?
  dataProximoContato          DateTime?
  motivoPerda                 String?

  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  @@map("lead_qualifications")
}

model LeadFollowUp {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  notes       String
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("lead_follow_ups")
}

model LeadStageHistory {
  id          String     @id @default(uuid())
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage   LeadStage?
  toStage     LeadStage
  reason      String?
  isReverted  Boolean    @default(false)
  revertedAt  DateTime?
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([leadId])
  @@index([toStage, createdAt])
  @@index([createdAt])
  @@map("lead_stage_histories")
}

enum ClientStatus {
  ATIVO
  PAUSADO
  CANCELADO
}

enum PlanCycle {
  MENSAL
  TRIMESTRAL
}

enum PlanType {
  TRIMESTRAL_REUNIAO
  TRIMESTRAL_NORMAL
  MENSAL_REUNIAO
  MENSAL_NORMAL
  PERSONALIZADO
}

enum PaymentStatus {
  EM_DIA
  PENDENTE
  INADIMPLENTE
}

enum OnboardingStage {
  BRIEFING_PREENCHIDO
  ACESSOS_LIBERADOS
  CRIATIVOS_APROVADOS
  CAMPANHAS_NO_AR
  CONCLUIDO
}

enum AlertType {
  LOW_BALANCE
  CPA_SPIKE
  ONBOARDING_DELAY
  INSTANCE_DOWN
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Client {
  id                   String        @id @default(uuid())
  nome                 String
  deliveryNome         String
  whatsapp             String
  segmento             String
  cidade               String
  status               ClientStatus  @default(ATIVO)
  
  // Vínculo 1:1 com o Lead de origem
  convertedLeadId      String?       @unique
  convertedLead        Lead?         @relation(fields: [convertedLeadId], references: [id], onDelete: SetNull)

  // Configuração Meta Ads (preenchido pelo time interno da MOVY)
  metaAdAccountId      String?       // ex: act_123456789
  metaPixelId          String?
  metaAccessTokenEnc   String?       // Token cifrado em AES-256-GCM (iv:authTag:encryptedData)
  metaTokenStatus      String?       @default("NOT_CONFIGURED") // NOT_CONFIGURED | ACTIVE | EXPIRED | INVALID
  metaTokenCreatedAt   DateTime?     // Data do cadastro (tokens de usuário duram até ~60 dias)
  metaTokenExpiresAt   DateTime?     // Data limite estimada de renovação
  metaLastSyncAt       DateTime?     // Data do último snapshot obtido com sucesso

  accountManagerId     String?
  accountManager       User?         @relation("AccountManagerClients", fields: [accountManagerId], references: [id], onDelete: SetNull)

  weeklyReports        WeeklyReport[]
  contract             Contract?

  // Tracker de Onboarding & SLA 48h
  onboardingStage          OnboardingStage       @default(BRIEFING_PREENCHIDO)
  onboardingStageUpdatedAt DateTime              @default(now())

  // Checklist de Ativos & Produção
  metaAccessGranted        Boolean               @default(false)
  pageAccessGranted        Boolean               @default(false)
  instagramAccessGranted   Boolean               @default(false)
  pixelCreated             Boolean               @default(false)
  videosReceived           Boolean               @default(false)
  creativesApproved        Boolean               @default(false)

  // Integração com Microserviço MOVY AI Concierge (WhatsApp Delivery)
  aiConciergeEnabled       Boolean               @default(false)
  conciergeTenantId        String?
  conciergeDigitalMenuUrl  String?
  conciergeOwnerEmail      String?
  conciergeLastSyncedAt    DateTime?

  // Relações Operacionais
  adAccountMetrics         AdAccountMetrics[]
  revenueReports           ClientRevenueReport[]
  alerts                   SystemAlert[]

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("clients")
}

model WeeklyReport {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  weekStartDate    DateTime
  weekEndDate      DateTime

  // Métricas extraídas da Meta Graph API
  metaSpend        Float    @default(0.0)
  metaImpressions  Int      @default(0)
  metaClicks       Int      @default(0)
  metaCtr          Float    @default(0.0)
  metaCpc          Float    @default(0.0)
  metaConversas    Int      @default(0)
  metaCostPerChat  Float    @default(0.0)
  metaRoas         Float?   @default(0.0) // Retorno sobre gasto em anúncios
  metaCpr          Float?   @default(0.0) // Custo por resultado (conversas ou pedidos)

  // Métricas de Vendas/Delivery
  faturamentoTotal Float?
  pedidosTotais    Int?

  // Análise e Recomendações do Gestor MOVY
  analiseGestor    String?
  proximasAcoes    String?

  // Arquivo do PDF gerado no padrão MOVY e envio via WhatsApp
  pdfUrl           String?
  whatsappSent     Boolean  @default(false)
  whatsappSentAt   DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("weekly_reports")
}

model Contract {
  id              String        @id @default(uuid())
  clientId        String        @unique
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  cycle           PlanCycle     @default(TRIMESTRAL)
  planType        PlanType      @default(TRIMESTRAL_REUNIAO)
  totalValue      Float         @default(4500.0) // Valor contratado (ex: R$ 4.500)
  mrrEquivalent   Float         @default(1500.0) // Parcela mensal de receita (ex: R$ 1.500)
  setupValue      Float         @default(0.0)    // Taxa de setup avulsa (se houver)
  mediaBudget     Float         @default(1500.0) // Verba de mídia de referência Meta Ads
  operationalCost Float         @default(150.0)  // Custo operacional COGS (ferramentas, proxies)
  dueDay          Int           @default(10)     // Dia de vencimento (1 a 31)
  paymentStatus   PaymentStatus @default(EM_DIA)

  startDate       DateTime      @default(now())
  endDate         DateTime?
  churnReason     String?
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("contracts")
}

model AdAccountMetrics {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date        DateTime // Data da captura diária
  spend       Float    @default(0.0) // Gasto do dia
  balance     Float    @default(0.0) // Saldo restante na conta de anúncios
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversas   Int      @default(0)
  cpa         Float    @default(0.0) // Custo por conversa / clique cardápio

  createdAt   DateTime @default(now())

  @@map("ad_account_metrics")
}

model ClientRevenueReport {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  periodStart  DateTime
  periodEnd    DateTime
  grossRevenue Float    // Faturamento bruto
  ordersCount  Int      // Total de pedidos
  source       String   @default("CSV_IMPORT") // MANUAL ou CSV_IMPORT
  filename     String?

  createdAt    DateTime @default(now())

  @@map("client_revenue_reports")
}

model SystemAlert {
  id        String        @id @default(uuid())
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type      AlertType
  severity  AlertSeverity @default(WARNING)
  message   String
  resolved  Boolean       @default(false)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("system_alerts")
}

enum ExpenseCategory {
  EQUIPE
  FERRAMENTAS_SAAS
  MARKETING_PROPRIO
  OUTROS
}

model Expense {
  id          String          @id @default(uuid())
  description String
  category    ExpenseCategory
  amount      Float
  dueDate     DateTime
  isRecurring Boolean         @default(false)
  isActive    Boolean         @default(true)
  notes       String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category, isActive])
  @@index([dueDate])
  @@map("expenses")
}


